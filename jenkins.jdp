pipeline {
    agent any
    stages {
        stage ('pull') {
           steps {
             git branch: 'Dev', url: 'https://github.com/SanjivaniHake/combine-project-backend.git'
           }
        }
        stage ('build') {
           steps {
             sh 'mvn clean package'
           }
        }
        stage ('deploy') {
           steps {
             sh '''
                docker build . -t hakesanjivani/com-backend:latest
                docker push hakesanjivani/com-backend:latest
                docker rmi hakesanjivani/com-backend:latest
                kubectl apply -f ./deployment.yaml/
                kubectl apply -f ./service.yaml/
             '''
            
           }
        }
    }
}